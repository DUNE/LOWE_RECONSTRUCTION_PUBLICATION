#!/bin/bash
:<<'EOF'
Single-particle chain for the 10 MeV electron/gamma smearing study (2026-10-08, thesis sec. 7.6).
Monte Carlo justIN workflow (--monte-carlo N): every job generates NUM_EVENTS events and runs
the le_mc_2024a production chain of the official marley samples:
  HD: gen -> supernova_g4_dune10kt_1x2x6 -> standard_detsim_dune10kt_1x2x6 -> reco1_supernova_dune10kt_1x2x6 (v09_91_04d00)
      -> reco2_supernova_dune10kt_1x2x6 (v09_91_04d01)
  VD: gen -> supernova_g4stage1 -> standard_g4stage2 -> standard_detsim -> standard_reco1 (v09_91_04d00)
      -> reco2_supernova_..._prod2024 (v09_91_04d01)
and SolarNuAna (v10_08_01 tarball) with the final marley defaults plus SignalLabel generator,
SaveSignalDaughters, SaveSignalEDep and SaveClusterEDep. G4 keeps the EM shower daughters so that
bremsstrahlung photons, Compton electrons and positrons are MCParticles.
Only the SolarNuAna hist file is kept.

Env: PHOTON_EVAPORATION (0|1), GEOM (hd|vd), PDG (11|22|2112), KE_MEV (kinetic energy; 2.5e-8 for thermal neutrons), KE_MAX_MEV (optional: flat spectrum KE_MEV-KE_MAX_MEV), NUM_EVENTS, INPUT_TAR_DIR_LOCAL
EOF

GEOM=${GEOM:-hd}
PDG=${PDG:-11}
KE_MEV=${KE_MEV:-10}
NUM_EVENTS=${NUM_EVENTS:-50}

did_pfn_rse=`$JUSTIN_PATH/justin-get-file`
if [ "$did_pfn_rse" = "" ] ; then
  echo "Nothing to process - exit jobscript"
  exit 0
fi
pfn=`echo $did_pfn_rse | cut -f2 -d' '`
echo "Monte Carlo counter = $pfn"
COUNTER=$((10#`echo $pfn | tr -dc '0-9' | tail -c 6`))
# Unique run/subrun per job: the perEvent seed policy then gives independent events
RUN=$((40000 + ${JUSTIN_WORKFLOW_ID:-0} % 10000))
SUBRUN=$((COUNTER + 1))

# Momentum in GeV for the requested kinetic energy
P0=`awk -v k=$KE_MEV -v pdg=$PDG 'BEGIN{m=0; if(pdg==11||pdg==-11) m=0.51099895; if(pdg==2112) m=939.56542; e=k+m; printf "%.6e", sqrt(k*(k+2*m))/1000.}'`
# KE_MAX_MEV set: flat momentum between those of KE_MEV and KE_MAX_MEV (flat in energy for electrons)
SIGMAP=0.
if [ -n "${KE_MAX_MEV:-}" ]; then
  read P0 SIGMAP < <(awk -v k1=$KE_MEV -v k2=$KE_MAX_MEV -v pdg=$PDG 'BEGIN{m=0; if(pdg==11||pdg==-11) m=0.51099895; if(pdg==2112) m=939.56542; p1=sqrt(k1*(k1+2*m))/1000.; p2=sqrt(k2*(k2+2*m))/1000.; printf "%.6e %.6e", (p1+p2)/2, (p2-p1)/2}')
fi
echo "GEOM=$GEOM PDG=$PDG KE=$KE_MEV-${KE_MAX_MEV:-$KE_MEV} MeV P0=$P0 SigmaP=$SIGMAP GeV RUN=$RUN SUBRUN=$SUBRUN NUM_EVENTS=$NUM_EVENTS"

if [ "$GEOM" = "hd" ]; then
  SERVICES=dunefd_1x2x6_simulation_services
  X0=0;    SX=350; Y0=0; SY=590; Z0=700;  SZ=690
  G4_FCLS="supernova_g4_dune10kt_1x2x6.fcl"
  DETSIM=standard_detsim_dune10kt_1x2x6.fcl
  RECO1=reco1_supernova_dune10kt_1x2x6.fcl
  RECO2=reco2_supernova_dune10kt_1x2x6.fcl
  ANA=solar_ana_marley_adjflash_radiological_decay0_dune10kt_1x2x6_centralAPA.fcl
else
  SERVICES=dunefdvd_1x8x14_3view_30deg_simulation_services
  X0=0;    SX=320; Y0=0; SY=665; Z0=1050; SZ=1040
  G4_FCLS="supernova_g4stage1_dunevd10kt_1x8x14_3view_30deg.fcl standard_g4stage2_dunevd10kt_1x8x14_3view_30deg.fcl"
  DETSIM=standard_detsim_dunevd10kt_1x8x14_3view_30deg.fcl
  RECO1=standard_reco1_dunevd10kt_1x8x14_3view_30deg.fcl
  RECO2=reco2_supernova_dunevd10kt_1x8x14_3view_30deg_prod2024.fcl
  ANA=solar_ana_marley_adjflash_radiological_decay0_dunevd10kt_1x8x14_3view_30deg.fcl
fi
GEN_COMMON=prodsingle_common_dunefd.fcl
[ "$GEOM" = "vd" ] && GEN_COMMON=prodsingle_common_dunefdvd10kt.fcl

mkdir -p fcl
cat > fcl/gun_gen.fcl <<FCL
#include "$GEN_COMMON"
process_name: SinglesGen
services: { @table::services @table::$SERVICES }
source.firstRun: $RUN
source.firstSubRun: $SUBRUN
physics.producers.generator.PDG: [ $PDG ]
physics.producers.generator.PosDist: 0
physics.producers.generator.X0: [ $X0 ]
physics.producers.generator.Y0: [ $Y0 ]
physics.producers.generator.Z0: [ $Z0 ]
physics.producers.generator.T0: [ 0. ]
physics.producers.generator.SigmaX: [ $SX ]
physics.producers.generator.SigmaY: [ $SY ]
physics.producers.generator.SigmaZ: [ $SZ ]
physics.producers.generator.SigmaT: [ 0. ]
physics.producers.generator.PDist: 0
physics.producers.generator.P0: [ $P0 ]
physics.producers.generator.SigmaP: [ $SIGMAP ]
physics.producers.generator.AngleDist: 0
physics.producers.generator.Theta0XZ: [ 0. ]
physics.producers.generator.Theta0YZ: [ 0. ]
physics.producers.generator.SigmaThetaXZ: [ 180. ]
physics.producers.generator.SigmaThetaYZ: [ 90. ]
FCL
i=0
for f in $G4_FCLS; do
  i=$((i+1))
  cat > fcl/gun_g4_$i.fcl <<FCL
#include "$f"
services.LArG4Parameters.KeepEMShowerDaughters: true
services.ParticleListAction.keepEMShowerDaughters: true
FCL
done
cat > fcl/gun_ana.fcl <<FCL
#include "$ANA"
physics.analyzers.solarnuana.SignalLabel: "generator"
physics.analyzers.solarnuana.SaveSignalDaughters: true
physics.analyzers.solarnuana.SaveSignalEDep: true
physics.analyzers.solarnuana.SaveClusterEDep: true
FCL
export FHICL_FILE_PATH_EXTRA=$PWD/fcl

source /cvmfs/dune.opensciencegrid.org/products/dune/setup_dune.sh

# PHOTON_EVAPORATION=1: neutron captures de-excite through G4PhotonEvaporation (level scheme, energy
# conserved per event) instead of the uncorrelated G4NDL capture-gamma spectra of the default NeutronHP
if [ "${PHOTON_EVAPORATION:-0}" = "1" ]; then
  export G4NEUTRONHP_USE_ONLY_PHOTONEVAPORATION=1
  export G4PHP_USE_ONLY_PHOTONEVAPORATION=1
  echo "NeutronHP capture through photon evaporation"
fi

run_stage() { # version fcl input output
  (
    setup dunesw $1 -q e26:prof
    export FHICL_FILE_PATH=$FHICL_FILE_PATH_EXTRA:$FHICL_FILE_PATH
    if [ "$3" = "none" ]; then
      lar -c $2 -n $NUM_EVENTS -o $4 > log_$4.txt 2>&1
    else
      lar -c $2 -s $3 -o $4 > log_$4.txt 2>&1
    fi
  )
  rc=$?
  echo "stage $2 ($1) exit $rc"
  tail -20 log_$4.txt
  [ $rc -ne 0 ] && exit $rc
}

run_stage v09_91_04d00 gun_gen.fcl none gen.root
prev=gen.root
i=0
for f in $G4_FCLS; do
  i=$((i+1))
  run_stage v09_91_04d00 gun_g4_$i.fcl $prev g4_$i.root
  rm -f $prev; prev=g4_$i.root
done
run_stage v09_91_04d00 $DETSIM $prev detsim.root;  rm -f $prev
run_stage v09_91_04d00 $RECO1 detsim.root reco1.root; rm -f detsim.root
run_stage v09_91_04d01 $RECO2 reco1.root reco2.root;  rm -f reco1.root

now=$(date -u +"%Y-%m-%dT_%H%M%SZ")
outHistFile=gun_${GEOM}_pdg${PDG}_${KE_MEV}${KE_MAX_MEV:+-$KE_MAX_MEV}MeV_pe${PHOTON_EVAPORATION:-0}_${RUN}_${SUBRUN}_${now}_hist.root
(
  source ${INPUT_TAR_DIR_LOCAL}/larsoft_v10_08_01/localProducts_larsoft_v10_08_01_e26_prof/setup_grid
  setup dunesw v10_08_01d00 -q e26:prof
  mrb uc
  mrbsetenv
  mrbslp
  export FHICL_FILE_PATH=$FHICL_FILE_PATH_EXTRA:$FHICL_FILE_PATH
  lar -c gun_ana.fcl -T $outHistFile reco2.root > log_ana.txt 2>&1
)
anaExit=$?
echo "SolarNuAna exit $anaExit"
tail -50 log_ana.txt
rm -f reco2.root

if [ $anaExit -eq 0 ] ; then
  echo "$pfn" > justin-processed-pfns.txt
fi
exit $anaExit
