# Byte-compiled / optimized files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Unit test / coverage reports
.coverage
.coverage.*
.cache
coverage.xml
.pytest_cache/

# Logs
*.log

# Jupyter Notebook
.ipynb_checkpoints
notebooks/*.ipynb

# Environments
.env
.envrc
.venv
env/
venv/
ENV/

# mypy / ruff
.mypy_cache/
.ruff_cache/

# Imported input data (keep directory structure)
input/data/*.csv
input/data/*.pkl
input/data/*/*.pkl
input/data/**/*.pkl
# SOLAR sync: remote mirror kept by scripts/sync_solar_data.sh (studies/ tree is covered above)
input/data/.solar_mirror/
input/captions/*.txt

# Imported script_lists expect the one named example_scripts.txt
input/plots/*.txt
input/tables/*.txt
!input/plots/example_scripts.txt

# Generated plots (keep directory structure)
output/plots/**/*.pdf
output/plots/**/*.svg
output/plots/**/*.eps
output/plots/**/*.jpg
output/plots/**/*.png
output/chapter9/**/*.png
output/chapter9/**/*.pdf

# Generated tables (keep directory structure)
output/tables/*.csv
output/tables/*.tsv
output/tables/*.xlsx
output/tables/*.html
output/tables/*.tex
output/tables/*/*.tex

# Generated test reports
styles/
tests/output/

# Generated presentations
output/presentations/*.pdf

# Generated study-status reports (timestamped snapshots from ch9_check_status.py)
input/status/

# Temporary files
tmp*/

# SSH password file for non-interactive sync_solar_data.sh auth (defaults to
# ~/.solar_sync_pass, outside the repo — this is a defensive backstop only)
.solar_sync_pass
