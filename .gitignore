# Byte-compiled / optimized files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Unit test / coverage reports
.coverage
.coverage.*
.cache
coverage.xml
.pytest_cache/

# Logs
*.log

# Jupyter Notebook
.ipynb_checkpoints
notebooks/*.ipynb

# Environments
.env
.envrc
.venv
env/
venv/
ENV/

# mypy / ruff
.mypy_cache/
.ruff_cache/

# Imported input data (keep directory structure)
input/data/*.csv
input/data/*.pkl
input/data/*/*.pkl
input/data/**/*.pkl
# SOLAR sync: remote mirror kept by scripts/sync_solar_data.sh (studies/ tree is covered above)
input/data/.solar_mirror/

# Generated plots and tables (the thesis lists write into THESIS through config/output_paths.json)
output/

# Generated test reports
styles/
tests/output/


# Generated study-status reports (timestamped snapshots from ch9_check_status.py)
input/status/

# Temporary files
tmp*/

# SSH password file for non-interactive sync_solar_data.sh auth (defaults to
# ~/.solar_sync_pass, outside the repo — this is a defensive backstop only)
.solar_sync_pass

# SOLAR exports synced by scripts/sync_solar_data.sh (json/csv sidecars, READMEs written by the export tools)
input/data/PDS/
input/data/TPC/
input/data/solar/
input/data/workflow/
input/data/best-sigma-json/
input/data/truth_position/scan_curves_fid.json
**/*.f0profile

