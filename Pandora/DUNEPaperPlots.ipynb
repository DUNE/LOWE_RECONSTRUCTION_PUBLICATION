    "    \n",
    "    bins = np.linspace(0, 10, 21)\n",
    "    weights1 = np.ones_like(drs1) / len(drs1)\n",
    "    weights1 = np.ones_like(drs1)\n",
    "    ax.hist(drs1, bins=bins, weights=weights1, histtype='step', lw=2, label=\"Pandora vertex using BDT\")\n",
    "    weights2 = np.ones_like(drs2) / len(drs2)\n",
    "    weights2 = np.ones_like(drs2)\n",
    "    ax.hist(drs2, bins=bins, weights=weights2, histtype='step', lw=2, label=\"Pandora vertex using CNN\")\n",
    "    \n",
    "    \"\"\"ax.set_title(\"3D vertex reconstruction\", fontsize=titlesize)\"\"\"\n",
    "    ax.tick_params(axis='x')\n",
    "    ax.tick_params(axis='y')\n",
    "    ax.set_xlabel(\"| True - Reco | (cm)\")\n",
    "    ax.set_ylabel(\"Count\")\n",
    "    ax.legend(fontsize='x-large')\n",
    "    \n",
    "    fig.tight_layout()\n",
    "    plt.savefig(\"3D_vertex_reconstruction_accuracy.pdf\", bbox_inches='tight')\n",
    "    plt.show()\n",
    "\n",
    "plot_dr_zoom(Array_one, Array_two)"
